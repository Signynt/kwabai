# Reference for a ~/.local prefix. --install-service generates exact local paths.
[Unit]
Description=Kwabai KDE window management
PartOf=graphical-session.target
After=graphical-session-pre.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 %h/.local/libexec/kwabai/start-session.py --build-dir %h/.local/bin --enable-control --background
Restart=on-failure
RestartPreventExitStatus=2 78
RestartSec=15
TimeoutStartSec=120
TimeoutStopSec=10
KillMode=control-group
UMask=0077

[Install]
WantedBy=graphical-session.target
